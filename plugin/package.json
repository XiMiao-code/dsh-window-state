{
  "name": "dsh-window-state",
  "version": "0.1.0",
  "description": "记住 DeepSeek Harness 桌面窗口关闭前的位置和大小，下次启动时恢复。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "window-state",
    "electron"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
